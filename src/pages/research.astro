---
import Base from '../layouts/Base.astro';
import { publications, projects } from '../data/research.js';
---
<Base title="Research" description="Publications and selected design projects by Kanxuan He." active="Research">
  <header class="page-hero">
    <p class="eyebrow">Research / 01</p>
    <h1>Research across scales</h1>
    <p>From future weather and building performance to human comfort and public life, these works ask how change can be measured, modeled, and made useful.</p>
  </header>
  <section class="catalog-section" aria-labelledby="publications-title">
    <div class="section-topline"><span>Publications</span><span>09 works / 2025–2026</span></div>
    <div class="catalog-head"><h2 id="publications-title">Publications</h2></div>
    <ol class="publication-list">
      {publications.map((item, index) => <li id={item.id} class="publication-item">
        <span class="publication-index">{String(index + 1).padStart(2, '0')}</span>
        <div class="publication-main">
          <p class="publication-meta">{item.itemType === 'journalArticle' ? 'Journal article' : 'Conference paper'} <span>·</span> {item.year}</p>
          <h3>{item.title}</h3>
          <p class="publication-authors">{item.authors.join(', ')}</p>
          <p class="publication-venue">{item.venue}</p>
        </div>
        <a class="publication-link" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Open public record for ${item.title}`}>Open <span aria-hidden="true">↗</span></a>
      </li>)}
    </ol>
  </section>
  <section class="catalog-section project-section" aria-labelledby="projects-title">
    <div class="section-topline"><span>Design practice</span><span>Selected earlier projects</span></div>
    <div class="catalog-head"><h2 id="projects-title">Selected design projects</h2></div>
    <div class="project-grid">{projects.map((project) => <article class="project-card">
      <p class="publication-meta">{project.type} · {project.period}</p>
      <h3>{project.title}</h3>
      <p>{project.description}</p>
      {project.url && <a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">Visit project <span aria-hidden="true">↗</span></a>}
    </article>)}</div>
  </section>
</Base>
