    <h1 id="contact-title" class="sr-only">Contact Kanxuan He</h1>
    <nav class="contact-icons" aria-label="Contact links">
      <a href="mailto:kanxuan.he@connect.hku.hk" aria-label="Email Kanxuan He">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 7 9 7 9-7"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/kanxuan-he" target="_blank" rel="noopener noreferrer" aria-label="Kanxuan He on LinkedIn">
